body{margin:0;font-family:Inter,sans-serif;background:#0a0a0a;color:#fff}
header{display:flex;justify-content:space-between;padding:20px 40px;background:#000;border-bottom:1px solid #d4af37}
.logo{color:#d4af37;font-weight:800;font-size:22px} .logo span{color:#fff}
nav a{color:#fff;margin-left:20px;text-decoration:none}
.hero{text-align:center;padding:100px 20px;background:linear-gradient(180deg,#000,#1a1a1a)}
.hero h1{font-size:48px;color:#d4af37} .hero p{opacity:.8}
button{background:#d4af37;color:#000;border:none;padding:12px 24px;font-weight:700;cursor:pointer;border-radius:6px}
.products{display:grid;grid-template-columns:repeat(3,1fr);gap:20px;padding:40px}
.card{background:#111;border:1px solid #d4af37;padding:20px;border-radius:10px;text-align:center}
footer{text-align:center;padding:30px;border-top:1px solid #d4af37;opacity:.6;font-size:12px}
